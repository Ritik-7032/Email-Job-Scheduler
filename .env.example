# Server & Environment Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database & Redis (PostgreSQL source of truth, Redis for BullMQ & Rate Limiter)
DATABASE_URL=postgresql://reachinbox:reachinbox_password@localhost:5432/reachinbox_scheduler?schema=public
REDIS_URL=redis://localhost:6379

# Google OAuth 2.0 (Google Cloud Console credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/callback

# Session / JWT Authentication Secret (min 16 characters)
JWT_SECRET=super-secret-jwt-key-reachinbox-scheduler-2026

# Ethereal SMTP Mailer Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SENDER_COUNT=5

# Worker Concurrency & Rate Limiting Controls
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR=200
DEFAULT_DELAY_MS=2000
DEFAULT_HOURLY_LIMIT=200
MAX_RECIPIENTS_PER_REQUEST=10000
STALE_PROCESSING_MS=300000
