NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://reachinbox:reachinbox_password@localhost:5432/reachinbox_scheduler?schema=public
REDIS_URL=redis://localhost:6379

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/callback
JWT_SECRET=your-development-jwt-secret-string-min-32-chars-key

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SENDER_COUNT=5

WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR=200
DEFAULT_DELAY_MS=2000
DEFAULT_HOURLY_LIMIT=200
MAX_RECIPIENTS_PER_REQUEST=1000
STALE_PROCESSING_MS=300000
